<UserControl x:Class="MediaVault.LinkHub.App.Controls.LinkLogoFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Width="96" Height="96">
        <Border x:Name="TileBackground" CornerRadius="12" />

        <Border x:Name="Viewport" CornerRadius="12">
            <Border.Clip>
                <RectangleGeometry x:Name="ViewportClip" RadiusX="12" RadiusY="12" Rect="0,0,96,96" />
            </Border.Clip>
            <Image x:Name="LogoImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="LogoTranslate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <TextBlock x:Name="GlyphText"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#E5E7EB"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
