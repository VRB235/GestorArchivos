<Window x:Class="MediaVault.LinkHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MediaVault &amp; LinkHub"
        Icon="/Assets/app-icon.ico"
        Height="820"
        Width="1280"
        MinHeight="640"
        MinWidth="1024"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Cursor="{Binding CurrentViewModel.IsBusy, Converter={StaticResource BooleanToWaitCursorConverter}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="/Assets/app-icon.png"
                               Width="40"
                               Height="40"
                               Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MediaVault"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="&amp; LinkHub"
                                       FontSize="14"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Gestor multimedia local"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <ItemsControl DockPanel.Dock="Top"
                              ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Target}">
                                <Button.Background>
                                    <MultiBinding Converter="{StaticResource NavigationHighlightConverter}">
                                        <Binding Path="DataContext.SelectedNavigationTarget" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Target" />
                                    </MultiBinding>
                                </Button.Background>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{Binding CurrentTitle}"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentSubtitle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#2A1F1F"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6"
                    Margin="0,0,0,12"
                    Visibility="{Binding CurrentViewModel.ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding CurrentViewModel.ErrorMessage}"
                           Foreground="#FCA5A5" />
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0">
                <Grid>
                    <ContentControl Content="{Binding CurrentViewModel}" />

                    <Border Background="#AA0F1117"
                            Cursor="Wait"
                            ForceCursor="True"
                            Visibility="{Binding CurrentViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Procesando..."
                                       FontSize="16"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentViewModel.StatusMessage}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
