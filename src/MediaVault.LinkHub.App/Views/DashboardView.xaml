<UserControl x:Class="MediaVault.LinkHub.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:charts="clr-namespace:MediaVault.LinkHub.App.Charts"
             xmlns:lvccore="clr-namespace:LiveChartsCore.Measure;assembly=LiveChartsCore"
             xmlns:controls="clr-namespace:MediaVault.LinkHub.App.Controls"
             xmlns:converters="clr-namespace:MediaVault.LinkHub.App.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <Style x:Key="SummaryStatCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SummaryProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#12151E" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DashboardBarChartTemplate">
            <lvc:CartesianChart Height="320"
                                Background="Transparent"
                                Series="{Binding Series}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                DrawMarginFrame="{Binding DrawMarginFrame}"
                                LegendPosition="Hidden"
                                FindingStrategy="ExactMatch"
                                TooltipPosition="{x:Static lvccore:TooltipPosition.Hidden}"
                                Cursor="Hand" />
        </DataTemplate>

        <DataTemplate x:Key="DashboardPieChartTemplate">
            <lvc:PieChart Height="320"
                          Background="Transparent"
                          Series="{Binding Series}"
                          LegendPosition="Right"
                          LegendTextPaint="#9CA3AF"
                          TooltipTextPaint="#F3F4F6"
                          TooltipBackgroundPaint="#1C1F2B" />
        </DataTemplate>

        <charts:DashboardChartTemplateSelector x:Key="DashboardChartTemplateSelector"
                                             BarChartTemplate="{StaticResource DashboardBarChartTemplate}"
                                             PieChartTemplate="{StaticResource DashboardPieChartTemplate}" />

        <!-- Pie oculto en reposo; aparece al hover sobre la card (como HistoryCoverCard en HobbyXP). -->
        <Style x:Key="RecommendationHoverOverlayStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                             Value="True">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Portada estilo HobbyXP + CoverFit (fondo blur + imagen Uniform sin deformar) -->
        <ItemsPanelTemplate x:Key="RecommendationCardsPanelTemplate">
            <UniformGrid Columns="5" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="RecommendedVideoCoverCardTemplate">
            <Border Height="248"
                    Margin="4,0"
                    HorizontalAlignment="Stretch"
                    Background="#152033"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    ToolTip="{Binding Video.Name}">
                <Grid>
                    <Border Background="#1A2233">
                        <Grid>
                            <TextBlock Text="Sin imagen"
                                       Foreground="#B0B8C8"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <controls:CoverFitImage Source="{Binding Thumbnail}"
                                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <Border VerticalAlignment="Bottom"
                            Style="{StaticResource RecommendationHoverOverlayStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000D1117" Offset="0" />
                                <GradientStop Color="#B30D1117" Offset="0.28" />
                                <GradientStop Color="#F20D1117" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="10,28,10,10">
                            <TextBlock Text="{Binding Video.Name}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#F5F8FC"
                                       TextWrapping="Wrap"
                                       MaxHeight="40"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.85" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <controls:StarRatingControl Rating="{Binding RankingStars, Mode=OneWay}"
                                                        IsInteractive="False"
                                                        Margin="0,6,0,2" />
                            <TextBlock Text="{Binding OpenCountLabel}"
                                       Foreground="#D7DEEA"
                                       FontSize="11">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding ResolutionDisplay}"
                                       Foreground="#D7DEEA"
                                       FontSize="11"
                                       Margin="0,0,0,8">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Abrir"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding DataContext.OpenRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,0"
                                        MinWidth="64"
                                        Padding="10,4"
                                        Cursor="Hand" />
                                <Button Content="VLC"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.OpenRecommendedWithVlcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MinWidth="52"
                                        Padding="10,4"
                                        Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RankedRecommendedVideoCoverCardTemplate">
            <Border Height="248"
                    Margin="4,0"
                    HorizontalAlignment="Stretch"
                    Background="#152033"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    ToolTip="{Binding Video.Name}">
                <Grid>
                    <Border Background="#1A2233">
                        <Grid>
                            <TextBlock Text="Sin imagen"
                                       Foreground="#B0B8C8"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <controls:CoverFitImage Source="{Binding Thumbnail}"
                                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <Border VerticalAlignment="Bottom"
                            Style="{StaticResource RecommendationHoverOverlayStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000D1117" Offset="0" />
                                <GradientStop Color="#B30D1117" Offset="0.28" />
                                <GradientStop Color="#F20D1117" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="10,28,10,10">
                            <TextBlock Text="{Binding Video.Name}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#F5F8FC"
                                       TextWrapping="Wrap"
                                       MaxHeight="40"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.85" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding TierLabel}"
                                       Foreground="#D7DEEA"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding ShowTierLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <controls:StarRatingControl Rating="{Binding RankingStars, Mode=OneWay}"
                                                        IsInteractive="False"
                                                        Margin="0,6,0,2" />
                            <TextBlock Text="{Binding OpenCountLabel}"
                                       Foreground="#D7DEEA"
                                       FontSize="11">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding ResolutionDisplay}"
                                       Foreground="#D7DEEA"
                                       FontSize="11"
                                       Margin="0,0,0,8">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7" Color="#000000" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Abrir"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding DataContext.OpenRankedRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,8,0"
                                        MinWidth="64"
                                        Padding="10,4"
                                        Cursor="Hand" />
                                <Button Content="VLC"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.OpenRankedRecommendedWithVlcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MinWidth="52"
                                        Padding="10,4"
                                        Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DashboardChartSectionTemplate">
            <Expander Style="{StaticResource DashboardExpanderStyle}"
                      IsExpanded="{Binding IsExpanded, Mode=OneWay}">
                <Expander.Header>
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Expander.Header>

                <StackPanel>
                    <TextBlock Text="{Binding FileOpenHint}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,0,8"
                               Visibility="{Binding SupportsFileOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0"
                                        Content="{Binding}"
                                        ContentTemplateSelector="{StaticResource DashboardChartTemplateSelector}" />

                        <Border Grid.Column="1"
                                Width="136"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="#1C1F2B"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Visibility="{Binding ShowHoverPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Image Source="{Binding HoverPreview}"
                                       Width="120"
                                       Height="120"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding HoverPreviewCaption}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding EmptyMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasData}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Expander Style="{StaticResource DashboardExpanderStyle}"
                      IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="Resumen"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Expander.Header>

                <StackPanel>
                    <TextBlock Text="Inventario"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="5" Margin="0,0,0,16">
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Archivos"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding TotalMediaFiles}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="&#xE714;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Videos"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding TotalVideos}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="&#xE91B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Fotos"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding TotalPhotos}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="&#xE71B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Enlaces"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding TotalWebLinks}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="&#xE70B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Notas"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding TotalQuickNotes}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Cobertura de videos"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Vistos al menos una vez"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding VideosOpenedSummary}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <ProgressBar Style="{StaticResource SummaryProgressBarStyle}"
                                             Value="{Binding VideosOpenedPercent}"
                                             Margin="0,10,0,6" />
                                <TextBlock Text="{Binding VideosNeverOpenedSummary}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Calificados"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding VideosRatedSummary}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <ProgressBar Style="{StaticResource SummaryProgressBarStyle}"
                                             Value="{Binding VideosRatedPercent}"
                                             Margin="0,10,0,6" />
                                <TextBlock Text="{Binding VideosUnratedSummary}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Aperturas de video"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding TotalVideoOpens}"
                                           FontSize="26"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding AverageOpensPerVideoLabel}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Calidad promedio"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Ranking global"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,6" />
                                <controls:StarRatingControl Rating="{Binding AverageGlobalRankingStars, Mode=OneWay}"
                                                            IsInteractive="False" />
                                <TextBlock Text="{Binding AverageGlobalRankingLabel}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Ranking videos"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,6" />
                                <controls:StarRatingControl Rating="{Binding AverageVideoRankingStars, Mode=OneWay}"
                                                            IsInteractive="False" />
                                <TextBlock Text="{Binding AverageVideoRankingLabel}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryStatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Ranking fotos"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,6" />
                                <controls:StarRatingControl Rating="{Binding AveragePhotoRankingStars, Mode=OneWay}"
                                                            IsInteractive="False" />
                                <TextBlock Text="{Binding AveragePhotoRankingLabel}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Expander>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Recomendado para ver"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Hasta 5 videos. Mezcla ranking, aperturas y azar."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,2,0,12" />

                    <ItemsControl ItemsSource="{Binding RecommendedVideos}"
                                  ItemTemplate="{StaticResource RecommendedVideoCoverCardTemplate}"
                                  ItemsPanel="{StaticResource RecommendationCardsPanelTemplate}"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding HasRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecommendation}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No hay videos indexados para recomendar. Indexe la carpeta raíz desde Configuración."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                    </StackPanel>

                    <Button Content="Otras recomendaciones"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshRecommendationCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            MinWidth="160" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Recomendado por ranking"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Hasta 5 videos: prioriza calificados (5★→1★); si faltan, completa con otros."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,2,0,12" />

                    <ItemsControl ItemsSource="{Binding RankedRecommendedVideos}"
                                  ItemTemplate="{StaticResource RankedRecommendedVideoCoverCardTemplate}"
                                  ItemsPanel="{StaticResource RecommendationCardsPanelTemplate}"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding HasRankedRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRankedRecommendation}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No hay videos calificados. Asigne estrellas en Media Vault para esta recomendación."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                    </StackPanel>

                    <Button Content="Otras recomendaciones"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshRankedRecommendationCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            MinWidth="160" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding PrimaryChartSections}"
                          ItemTemplate="{StaticResource DashboardChartSectionTemplate}" />

            <Expander Style="{StaticResource DashboardExpanderStyle}"
                      IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="Otras métricas"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Expander.Header>

                <ItemsControl ItemsSource="{Binding SecondaryChartSections}"
                              ItemTemplate="{StaticResource DashboardChartSectionTemplate}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
