<UserControl x:Class="MediaVault.LinkHub.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:charts="clr-namespace:MediaVault.LinkHub.App.Charts"
             xmlns:lvccore="clr-namespace:LiveChartsCore.Measure;assembly=LiveChartsCore"
             xmlns:controls="clr-namespace:MediaVault.LinkHub.App.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="DashboardBarChartTemplate">
            <lvc:CartesianChart Height="320"
                                Background="Transparent"
                                Series="{Binding Series}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                DrawMarginFrame="{Binding DrawMarginFrame}"
                                LegendPosition="Hidden"
                                FindingStrategy="ExactMatch"
                                TooltipPosition="{x:Static lvccore:TooltipPosition.Hidden}"
                                Cursor="Hand" />
        </DataTemplate>

        <DataTemplate x:Key="DashboardPieChartTemplate">
            <lvc:PieChart Height="320"
                          Background="Transparent"
                          Series="{Binding Series}"
                          LegendPosition="Right"
                          LegendTextPaint="#9CA3AF"
                          TooltipTextPaint="#F3F4F6"
                          TooltipBackgroundPaint="#1C1F2B" />
        </DataTemplate>

        <charts:DashboardChartTemplateSelector x:Key="DashboardChartTemplateSelector"
                                             BarChartTemplate="{StaticResource DashboardBarChartTemplate}"
                                             PieChartTemplate="{StaticResource DashboardPieChartTemplate}" />

        <DataTemplate x:Key="DashboardChartSectionTemplate">
            <Expander Style="{StaticResource DashboardExpanderStyle}"
                      IsExpanded="{Binding IsExpanded, Mode=OneWay}">
                <Expander.Header>
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Expander.Header>

                <StackPanel>
                    <TextBlock Text="{Binding FileOpenHint}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,0,8"
                               Visibility="{Binding SupportsFileOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0"
                                        Content="{Binding}"
                                        ContentTemplateSelector="{StaticResource DashboardChartTemplateSelector}" />

                        <Border Grid.Column="1"
                                Width="136"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="#1C1F2B"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Visibility="{Binding ShowHoverPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Image Source="{Binding HoverPreview}"
                                       Width="120"
                                       Height="120"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding HoverPreviewCaption}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding EmptyMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasData}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Expander Style="{StaticResource DashboardExpanderStyle}"
                      IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="Resumen"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Expander.Header>

                <WrapPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Archivos" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TotalMediaFiles}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Videos" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TotalVideos}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Fotos" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TotalPhotos}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Enlaces" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TotalWebLinks}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="150" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Notas" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TotalQuickNotes}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="170" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Aperturas video" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TotalVideoOpens}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="170" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Sin abrir" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding VideosNeverOpened}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="170" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Sin calificar" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding VideosUnrated}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="190" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Ranking global" Style="{StaticResource LabelStyle}" />
                            <controls:StarRatingControl Rating="{Binding AverageGlobalRankingStars, Mode=OneWay}"
                                                        IsInteractive="False"
                                                        Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="190" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Ranking videos" Style="{StaticResource LabelStyle}" />
                            <controls:StarRatingControl Rating="{Binding AverageVideoRankingStars, Mode=OneWay}"
                                                        IsInteractive="False"
                                                        Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Width="190" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Ranking fotos" Style="{StaticResource LabelStyle}" />
                            <controls:StarRatingControl Rating="{Binding AveragePhotoRankingStars, Mode=OneWay}"
                                                        IsInteractive="False"
                                                        Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Expander>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Recomendado para ver"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Hasta 5 videos. Mezcla ranking, aperturas y azar."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,2,0,12" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding RecommendedVideos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="210"
                                            Margin="0,0,12,0"
                                            Padding="10"
                                            Background="#1C1F2B"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Height="120"
                                                    Background="#12151E"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Margin="0,0,0,8">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <TextBlock Text="{Binding Video.Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <controls:StarRatingControl Rating="{Binding RankingStars, Mode=OneWay}"
                                                                        IsInteractive="False"
                                                                        Margin="0,6,0,2" />
                                            <TextBlock Text="{Binding OpenCountLabel}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding ResolutionDisplay}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Abrir"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0"
                                                        MinWidth="64"
                                                        Padding="10,4" />
                                                <Button Content="VLC"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenRecommendedWithVlcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        MinWidth="52"
                                                        Padding="10,4" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecommendation}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No hay videos indexados para recomendar. Indexe la carpeta raíz desde Configuración."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                    </StackPanel>

                    <Button Content="Otras recomendaciones"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshRecommendationCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            MinWidth="160" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Recomendado por ranking"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Hasta 5 videos: prioriza calificados (5★→1★); si faltan, completa con otros."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,2,0,12" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasRankedRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding RankedRecommendedVideos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="210"
                                            Margin="0,0,12,0"
                                            Padding="10"
                                            Background="#1C1F2B"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Height="120"
                                                    Background="#12151E"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Margin="0,0,0,8">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <TextBlock Text="{Binding Video.Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding TierLabel}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0" />
                                            <controls:StarRatingControl Rating="{Binding RankingStars, Mode=OneWay}"
                                                                        IsInteractive="False"
                                                                        Margin="0,6,0,2" />
                                            <TextBlock Text="{Binding OpenCountLabel}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding ResolutionDisplay}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Abrir"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenRankedRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0"
                                                        MinWidth="64"
                                                        Padding="10,4" />
                                                <Button Content="VLC"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenRankedRecommendedWithVlcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        MinWidth="52"
                                                        Padding="10,4" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRankedRecommendation}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No hay videos calificados. Asigne estrellas en Media Vault para esta recomendación."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                    </StackPanel>

                    <Button Content="Otras recomendaciones"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshRankedRecommendationCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            MinWidth="160" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding PrimaryChartSections}"
                          ItemTemplate="{StaticResource DashboardChartSectionTemplate}" />

            <Expander Style="{StaticResource DashboardExpanderStyle}"
                      IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="Otras métricas"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Expander.Header>

                <ItemsControl ItemsSource="{Binding SecondaryChartSections}"
                              ItemTemplate="{StaticResource DashboardChartSectionTemplate}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
