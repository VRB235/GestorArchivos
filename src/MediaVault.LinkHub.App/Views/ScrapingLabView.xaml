<UserControl x:Class="MediaVault.LinkHub.App.Views.ScrapingLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MediaVault.LinkHub.App.Controls"
             xmlns:converters="clr-namespace:MediaVault.LinkHub.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="320" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Configuración / selectores -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Configuración de prueba"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Dry-run sin persistir. Ideal para SPA/WAF: ForceBrowser / PreferBrowserFetch + captura hover."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Sitio (opcional, carga hints)"
                               Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding WebLinks}"
                              SelectedItem="{Binding SelectedWebLink}"
                              DisplayMemberPath="Nombre"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Cargar hints de productora (si no, actriz)"
                              IsChecked="{Binding LoadProducerHints}"
                              Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Aplicar hints del sitio"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ApplySelectedWebLinkHintsCommand}"
                                Margin="0,0,8,4"
                                Padding="10,4" />
                        <Button Content="Resolver URL muestra"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ResolveSampleUrlCommand}"
                                Margin="0,0,0,4"
                                Padding="10,4"
                                ToolTip="Usa ActressLink/ProducerLink del sitio, o la URL base." />
                    </WrapPanel>

                    <TextBlock Text="URL de muestra"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding SampleUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <TextBlock Text="ScraperKey"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding ScraperKey, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Probar selectores"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ProbeSelectorsCommand}"
                                Margin="0,0,8,4" />
                        <Button Content="Plantilla"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ApplyHintsTemplateCommand}"
                                Margin="0,0,8,4"
                                Padding="10,4" />
                        <Button Content="Capturar previews (hover)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CaptureHoverPreviewsCommand}"
                                Margin="0,0,0,4"
                                Padding="10,4"
                                ToolTip="WebView2: simula hover y aplica PreviewUrl en memoria (sin BD)." />
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <controls:ScrapeHintsEditor DataContext="{Binding Hints}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- Resultados + preview -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*" MinHeight="160" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" MinHeight="220" />
                <RowDefinition Height="8" />
                <RowDefinition Height="0.85*" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Candidatos (dry-run)"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Candidates}"
                             SelectedItem="{Binding SelectedCandidate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="88"
                                            Height="56"
                                            Background="#1C1F2B"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding SourceUrl}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding PreviewUrl}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasPreviewUrl, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Vista previa / verificación de carga"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button Content="Probar preview seleccionado"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding TestSelectedPreviewCommand}"
                                HorizontalAlignment="Right"
                                Padding="10,4" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding PreviewStatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Grid Height="200">
                        <Border Background="#12141C"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding PreviewIsVideo, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <MediaElement x:Name="PreviewMedia"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Stop"
                                              Stretch="Uniform"
                                              Volume="0"
                                              MediaOpened="PreviewMedia_OnMediaOpened"
                                              MediaFailed="PreviewMedia_OnMediaFailed"
                                              MediaEnded="PreviewMedia_OnMediaEnded"
                                              Visibility="{Binding PreviewIsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Log de diagnóstico"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button Content="Copiar log"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopyDiagnosticLogCommand}"
                                HorizontalAlignment="Right"
                                Padding="10,4" />
                    </DockPanel>
                    <TextBox Text="{Binding DiagnosticLog, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#12141C"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             BorderThickness="0"
                             Padding="8" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
