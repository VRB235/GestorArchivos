<UserControl x:Class="MediaVault.LinkHub.App.Views.VideoDownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Nueva descarga"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Acepta playlists HLS (.m3u8). Si la URL lleva token (?t=&amp;e=), descargue antes de que expire."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Text="URL del video / playlist"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         MinHeight="44"
                         Margin="0,0,0,8" />

                <TextBlock Text="Nombre (opcional)"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding DisplayNameInput, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Encolar y descargar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding EnqueueCommand}"
                            Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Historial"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,8" />

                <ListBox ItemsSource="{Binding Downloads}"
                         SelectedItem="{Binding SelectedDownload}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,10"
                                    Margin="0,0,0,6"
                                    Background="#14FFFFFF"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding SourceUrl}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SourceUrl}"
                                               Margin="0,4,0,6" />

                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0"
                                                     Height="10"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProgressText}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>

                                    <DockPanel Grid.Row="3">
                                        <WrapPanel DockPanel.Dock="Right">
                                            <Button Content="Abrir"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="10,4"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanOpen}" />
                                            <Button Content="Carpeta"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanOpen}" />
                                            <Button Content="Cancelar"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanCancel}" />
                                            <Button Content="Reintentar"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanRetry}" />
                                            <Button Content="Eliminar"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Padding="10,4"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding StatusText}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
