<UserControl x:Class="MediaVault.LinkHub.App.Views.VideoCategoryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Categorías registradas"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock DockPanel.Dock="Top"
                           Text="Seleccione una categoría para renombrarla o eliminarla."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />
                <ListBox ItemsSource="{Binding VideoCategories}"
                         SelectedItem="{Binding SelectedCategory}"
                         DisplayMemberPath="Name" />
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock Text="Editor de categoría" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Las categorías se asignan a archivos indexados desde Media Vault (la indexación se lanza en Configuración)."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="Nombre" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" />

                <WrapPanel Margin="0,4,0,0">
                    <Button Content="Agregar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCategoryCommand}" />
                    <Button Content="Renombrar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RenameCategoryCommand}" />
                    <Button Content="Eliminar"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteCategoryCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
