<UserControl x:Class="MediaVault.LinkHub.App.Views.SuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:MediaVault.LinkHub.App.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:DateTimeLocalConverter x:Key="DateTimeLocalConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Filtro" Style="{StaticResource LabelStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Todas"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,6,0"
                                Command="{Binding ShowAllCommand}" />
                        <Button Content="Pendientes"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,6,0"
                                Command="{Binding ShowPendingCommand}" />
                        <Button Content="Resueltas"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ShowResolvedCommand}" />
                    </StackPanel>

                    <TextBlock Text="Fecha de creación" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desde" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <DatePicker SelectedDate="{Binding FilterFromDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hasta" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <DatePicker SelectedDate="{Binding FilterToDate}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Limpiar fechas"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Command="{Binding ClearDateFilterCommand}" />

                    <TextBlock Text="{Binding FilterLabel, StringFormat=Mostrando: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Suggestions}"
                         SelectedItem="{Binding SelectedSuggestion}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right"
                                            Background="#2E7D32"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding Resuelto, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Resuelto" Foreground="White" FontSize="10" />
                                    </Border>
                                    <Border DockPanel.Dock="Right"
                                            Background="#C62828"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding Resuelto, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="Pendiente" Foreground="White" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="{Binding Tipo}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Texto}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding FechaCreacion, Converter={StaticResource DateTimeLocalConverter}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Detalle" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Tipo" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding KindOptions}"
                              SelectedItem="{Binding Tipo}"
                              Margin="0,0,0,10" />

                    <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="180"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10" />

                    <CheckBox Content="Marcado como resuelto"
                              IsChecked="{Binding Resuelto}"
                              Margin="0,0,0,8" />

                    <TextBlock Text="{Binding FechaCreacionTexto, StringFormat=Creado: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Visibility="{Binding FechaCreacionTexto, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock Text="{Binding FechaResueltoTexto, StringFormat=Resuelto: {0}}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,2,0,10"
                               Visibility="{Binding FechaResueltoTexto, Converter={StaticResource NullToVisibilityConverter}}" />

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Agregar imagen"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddImageCommand}" />
                        <TextBlock Text="Imágenes adjuntas" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,8,8"
                                        Padding="6"
                                        Width="150">
                                    <StackPanel>
                                        <Button Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Abrir imagen"
                                                Padding="0"
                                                Margin="0,0,0,6">
                                            <Image Source="{Binding Image}"
                                                   Height="90"
                                                   Stretch="Uniform" />
                                        </Button>
                                        <TextBlock Text="{Binding OriginalFileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="11"
                                                   ToolTip="{Binding OriginalFileName}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Abrir"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Quitar"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" />
                        <Button Content="Nueva"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearFormCommand}" />
                        <Button Content="Alternar resuelto"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleResolvedCommand}" />
                        <Button Content="Eliminar"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
