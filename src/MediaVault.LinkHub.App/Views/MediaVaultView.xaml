<UserControl x:Class="MediaVault.LinkHub.App.Views.MediaVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:MediaVault.LinkHub.App.Converters"
             xmlns:controls="clr-namespace:MediaVault.LinkHub.App.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:MediaVaultBrowserThumbnailConverter x:Key="MediaVaultBrowserThumbnailConverter" />
        <converters:MediaVaultBrowserGlyphConverter x:Key="MediaVaultBrowserGlyphConverter" />

        <Style x:Key="BrowserTileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TileBorder"
                                Background="Transparent"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="12"
                                Padding="6"
                                Margin="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#243B63" />
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#1A2233" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExplorerIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#12151E" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1A2233" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#243B63" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerDangerIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#12151E" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C53030" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C53030" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Indexación" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Carpeta configurada"
                           Style="{StaticResource LabelStyle}" />
                <TextBlock Text="La ruta se define en Configuración y se mantiene entre sesiones."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding IndexRootPath}"
                             IsReadOnly="True"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Content="Indexar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding IndexCommand}" />
                </Grid>
                <TextBlock Text="{Binding LastIndexSummary}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Explorador"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding CurrentDirectoryPath}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCurrentDirectoryRanking}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Ranking carpeta:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <controls:StarRatingControl Rating="{Binding CurrentDirectoryAverageRankingStars, Mode=OneWay}"
                                                        IsInteractive="False"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentDirectoryAverageRanking, StringFormat={}{0:F2} / 5}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="{Binding CurrentDirectoryRankedFileCount, StringFormat='({0} archivos)'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Left">
                            <Button Style="{StaticResource ExplorerIconButtonStyle}"
                                    Command="{Binding NavigateUpCommand}"
                                    IsEnabled="{Binding CanNavigateUp}"
                                    ToolTip="Subir carpeta">
                                <TextBlock Text="&#xE110;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource ExplorerDangerIconButtonStyle}"
                                    Command="{Binding DeleteCommand}"
                                    IsEnabled="{Binding CanDeleteSelectedEntry}"
                                    ToolTip="Eliminar archivo o carpeta">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </WrapPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"
                                     ToolTip="Nombre de la nueva carpeta" />
                            <Button Grid.Column="1"
                                    Content="Nueva carpeta"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CreateFolderCommand}"
                                    MinWidth="120" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Buscar"
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2"
                                       Text="Tipo"
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding MediaTypeFilters}"
                                      SelectedItem="{Binding SelectedMediaTypeFilter}"
                                      DisplayMemberPath="Label" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding BrowserFilterSummary}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Limpiar filtros"
                                    Command="{Binding ClearBrowserFiltersCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Padding" Value="10,4" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveBrowserFilters}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Ordenar por"
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSortOption}"
                                      DisplayMemberPath="Label"
                                      Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2"
                                       Text="Orden"
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding SortDirections}"
                                      SelectedItem="{Binding SelectedSortDirection}"
                                      DisplayMemberPath="Label" />
                        </Grid>
                        <CheckBox Content="Mostrar archivos y carpetas ocultos"
                                  IsChecked="{Binding ShowHiddenFilesAndFolders}"
                                  Margin="0,8,0,0" />
                    </StackPanel>

                    <ListBox x:Name="BrowserListBox"
                             ItemsSource="{Binding BrowserEntries}"
                             SelectedItem="{Binding SelectedBrowserEntryItem}"
                             ItemContainerStyle="{StaticResource BrowserTileListBoxItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="BrowserListBox_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="118" HorizontalAlignment="Center">
                                    <Grid Width="96" Height="96" Margin="0,0,0,8" Background="Transparent">
                                        <Border Width="96"
                                                Height="96"
                                                CornerRadius="16"
                                                Background="#12151E"
                                                ClipToBounds="True">
                                            <Border.Clip>
                                                <RectangleGeometry RadiusX="16" RadiusY="16" Rect="0,0,96,96" />
                                            </Border.Clip>
                                            <Image x:Name="PreviewImage"
                                                   Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <Border HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="8"
                                                CornerRadius="8"
                                                Background="#661C1F2B"
                                                Visibility="{Binding ShowThumbnailLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🎬"
                                                           FontSize="22"
                                                           Opacity="0.55"
                                                           HorizontalAlignment="Center" />
                                                <ProgressBar IsIndeterminate="True"
                                                             Width="52"
                                                             Height="4"
                                                             Margin="0,8,0,4" />
                                                <TextBlock Text="Miniatura..."
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding Entry, Converter={StaticResource MediaVaultBrowserGlyphConverter}}"
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#9CA3AF">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Thumbnail}" Value="{x:Null}" />
                                                                <Condition Binding="{Binding ShowThumbnailLoading}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontWeight="SemiBold"
                                               MaxHeight="40"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding FileType}"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />

                                    <TextBlock Text="{Binding OpenCountLabel}"
                                               TextAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding ShowOpenCount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Elemento seleccionado" Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel Visibility="{Binding IsSelectedFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Miniatura personalizada"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="Asigne una imagen que represente esta carpeta en el explorador."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <Grid Width="96"
                                  Height="96"
                                  Margin="0,0,0,12"
                                  HorizontalAlignment="Left">
                                <Border Width="96"
                                        Height="96"
                                        CornerRadius="16"
                                        Background="#12151E"
                                        ClipToBounds="True">
                                    <Border.Clip>
                                        <RectangleGeometry RadiusX="16" RadiusY="16" Rect="0,0,96,96" />
                                    </Border.Clip>
                                    <Image Source="{Binding SelectedBrowserEntryItem.Thumbnail}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="6"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <Button Style="{StaticResource ExplorerDangerIconButtonStyle}"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="0,-6,-6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Command="{Binding ClearFolderIconCommand}"
                                        ToolTip="Limpiar miniatura"
                                        Visibility="{Binding CanClearFolderIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="&#xE894;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <TextBlock Text="Ruta de imagen" Style="{StaticResource LabelStyle}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedFolderIconPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="Examinar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseFolderIconCommand}" />
                            </Grid>

                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Guardar miniatura"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveFolderIconCommand}" />
                                <Button Content="Limpiar miniatura"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ClearFolderIconCommand}" />
                                <Button Content="Eliminar carpeta"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteCommand}"
                                        IsEnabled="{Binding CanDeleteSelectedEntry}" />
                            </WrapPanel>

                            <TextBlock Text="Ranking promedio de la carpeta" Style="{StaticResource LabelStyle}" />
                            <StackPanel Visibility="{Binding HasSelectedFolderRanking, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <controls:StarRatingControl Rating="{Binding SelectedFolderAverageRankingStars, Mode=OneWay}"
                                                                IsInteractive="False"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedFolderAverageRanking, StringFormat={}{0:F2} / 5}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedFolderRankedFileCount, StringFormat='Promedio de {0} archivo(s) calificado(s) en esta carpeta.'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="Sin archivos calificados en esta carpeta."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedFolderRanking}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Seleccione un archivo indexado (multimedia) para calificarlo con estrellas o abrirlo."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMediaFile}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Nuevo nombre" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding NewFileName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditSelectedFile}" />

                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding CanEditSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Aperturas" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedMediaFile.VecesAbierto, StringFormat={}{0} veces}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding ShowVideoResolutionSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Resolución" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedVideoResolutionDisplay}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding ShowFileCategorySection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Categorías" Style="{StaticResource LabelStyle}" />
                                <ItemsControl ItemsSource="{Binding FileCategorySelections}"
                                              Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource CategoryTagToggleStyle}"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0,0,6,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding FileCategoryHint}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding ShowFileActressSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Actrices" Style="{StaticResource LabelStyle}" />
                                <ItemsControl ItemsSource="{Binding FileActressSelections}"
                                              Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource CategoryTagToggleStyle}"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.CanAssignActress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Margin="0,0,6,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding FileActressHint}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding ShowFileProducerSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Productoras" Style="{StaticResource LabelStyle}" />
                                <ItemsControl ItemsSource="{Binding FileProducerSelections}"
                                              Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource CategoryTagToggleStyle}"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.CanAssignProducer, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Margin="0,0,6,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding FileProducerHint}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding ShowVideoThumbnailSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Miniaturas del video" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding VideoThumbnailHint}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding AssignedVideoThumbnails}"
                                              Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="84"
                                                    Margin="0,0,8,8"
                                                    Padding="4"
                                                    Background="#22FFFFFF"
                                                    CornerRadius="14"
                                                    ToolTip="{Binding FileName}">
                                                <Grid>
                                                    <Border Width="72"
                                                            Height="72"
                                                            CornerRadius="12"
                                                            Background="#12151E"
                                                            ClipToBounds="True">
                                                        <Border.Clip>
                                                            <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,72,72" />
                                                        </Border.Clip>
                                                        <Image Source="{Binding Preview}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="4"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <Button Content="×"
                                                            Width="22"
                                                            Height="22"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-2,-2,0"
                                                            Padding="0"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Command="{Binding DataContext.RemoveVideoThumbnailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Quitar miniatura" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <Button Content="Agregar desde Pictures…"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding AddVideoThumbnailsCommand}"
                                            IsEnabled="{Binding CanManageVideoThumbnails}" />
                                    <Button Content="Limpiar"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding ClearVideoThumbnailsCommand}"
                                            IsEnabled="{Binding HasAssignedVideoThumbnails}" />
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock Text="Calidad" Style="{StaticResource LabelStyle}" />
                            <controls:StarRatingControl Rating="{Binding RankingCalidad, Mode=TwoWay}"
                                                        IsInteractive="{Binding CanEditSelectedFile}"
                                                        Margin="0,0,0,8" />

                            <TextBlock Text="Contenido" Style="{StaticResource LabelStyle}" />
                            <controls:StarRatingControl Rating="{Binding RankingContenido, Mode=TwoWay}"
                                                        IsInteractive="{Binding CanEditSelectedFile}"
                                                        Margin="0,0,0,8" />

                            <TextBlock Text="Gusto" Style="{StaticResource LabelStyle}" />
                            <controls:StarRatingControl Rating="{Binding RankingGusto, Mode=TwoWay}"
                                                        IsInteractive="{Binding CanEditSelectedFile}"
                                                        Margin="0,0,0,8" />

                            <TextBlock Text="Ranking global" Style="{StaticResource LabelStyle}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <controls:StarRatingControl Rating="{Binding RankingGlobalStars, Mode=OneWay}"
                                                            IsInteractive="False"
                                                            VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding RankingGlobal, StringFormat={}{0:F2} / 5}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFileRanking}" Value="False">
                                                    <Setter Property="Text" Value="Sin calificar" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="Promedio de calidad, contenido y gusto."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Abrir"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenCommand}"
                                        IsEnabled="{Binding CanEditSelectedFile}" />
                                <Button Content="VLC"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenWithVlcCommand}"
                                        IsEnabled="{Binding CanEditSelectedFile}" />
                                <Button Content="Renombrar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RenameCommand}"
                                        IsEnabled="{Binding CanEditSelectedFile}" />
                                <Button Content="Mover"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding MoveCommand}"
                                        IsEnabled="{Binding CanMoveSelectedFile}" />
                                <Button Content="Eliminar"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteCommand}"
                                        IsEnabled="{Binding CanDeleteSelectedEntry}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
