<UserControl x:Class="MediaVault.LinkHub.App.Views.ActressesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MediaVault.LinkHub.App.Controls"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MinWidth="320" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Catálogo"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Row="1"
                               Text="Agregue o edite actrices. La asignación a videos se hace en Media Vault."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Actresses}"
                             SelectedItem="{Binding SelectedActress}"
                             DisplayMemberPath="Name"
                             Margin="0,0,0,8"
                             MinHeight="120"
                             MaxHeight="180" />
                    <TextBlock Grid.Row="3"
                               Text="Nombre"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="4"
                             Text="{Binding ActressName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             MinWidth="280"
                             HorizontalAlignment="Stretch" />
                    <WrapPanel Grid.Row="5">
                        <Button Content="Agregar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddActressCommand}" />
                        <Button Content="Renombrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RenameActressCommand}" />
                        <Button Content="Eliminar"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteActressCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <StackPanel>
                        <TextBlock Text="Filtros"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="OR dentro de cada grupo. Si combina actrices, categorías y productoras, se exige coincidencia en todos los grupos activos (AND)."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Actrices"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ActressFilterTags}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource CategoryTagToggleStyle}"
                                                  Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,6,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Categorías"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding CategoryFilterTags}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource CategoryTagToggleStyle}"
                                                  Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,6,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Productoras"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ProducerFilterTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource CategoryTagToggleStyle}"
                                                  Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,6,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Videos"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ResultsSummary}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Abrir"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenSelectedVideoCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="VLC"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenSelectedVideoWithVlcCommand}" />
                    </StackPanel>
                </DockPanel>

                <ListBox ItemsSource="{Binding Videos}"
                         SelectedItem="{Binding SelectedVideo}"
                         MouseDoubleClick="VideosListBox_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="72"
                                        Height="72"
                                        Background="#1C1F2B"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FolderName}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ActressesLabel}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding CategoriesLabel}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ProducersLabel}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <controls:StarRatingControl Rating="{Binding RankingStars, Mode=OneWay}"
                                                                    IsInteractive="False" />
                                        <TextBlock Text="{Binding OpenCountLabel}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
