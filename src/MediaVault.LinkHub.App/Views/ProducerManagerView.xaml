<UserControl x:Class="MediaVault.LinkHub.App.Views.ProducerManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Productoras registradas"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock DockPanel.Dock="Top"
                           Text="Seleccione una productora para renombrarla o eliminarla."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />
                <ListBox ItemsSource="{Binding Producers}"
                         SelectedItem="{Binding SelectedProducer}"
                         DisplayMemberPath="Name" />
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
            <StackPanel>
                <TextBlock Text="Editor de productora" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Las productoras se asocian a enlaces en Link Manager y también pueden etiquetar videos en Media Vault."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="Nombre" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding ProducerName, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="280"
                         HorizontalAlignment="Stretch" />

                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Agregar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddProducerCommand}" />
                    <Button Content="Renombrar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RenameProducerCommand}" />
                    <Button Content="Eliminar"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteProducerCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
