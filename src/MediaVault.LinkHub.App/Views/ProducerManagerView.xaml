<UserControl x:Class="MediaVault.LinkHub.App.Views.ProducerManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MediaVault.LinkHub.App.Controls"
             mc:Ignorable="d">
    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Catálogo"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Logo desde Link Manager (sitio asociado). Doble clic abre catálogo / scrape."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               TextWrapping="Wrap" />
                </DockPanel>

                <ListBox ItemsSource="{Binding Catalog}"
                         SelectedItem="{Binding SelectedCatalogItem}"
                         MouseDoubleClick="CatalogListBox_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tile"
                                                Width="118"
                                                Background="#161925"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="#1C2030" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <controls:LinkLogoFrame LogoPath="{Binding LogoPath}"
                                                        Category="{Binding Category}"
                                                        Zoom="{Binding LogoZoom}"
                                                        OffsetX="{Binding LogoOffsetX}"
                                                        OffsetY="{Binding LogoOffsetY}"
                                                        FrameSize="72"
                                                        HorizontalAlignment="Center"
                                                        Margin="8,8,8,0" />
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Margin="8,8,8,10"
                                           MaxHeight="36"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Gestionar"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="Asocie cada productora a un sitio en Link Manager para mostrar su logo aquí."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="Nombre" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding ProducerName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8" />

                <Button Content="Agregar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddProducerCommand}"
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch" />
                <Button Content="Renombrar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RenameProducerCommand}"
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch" />
                <Button Content="Catálogo / scrape"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenCatalogLinksCommand}"
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch" />
                <Button Content="Eliminar"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeleteProducerCommand}"
                        HorizontalAlignment="Stretch" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
